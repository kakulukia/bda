-extends 'index.pug'
-load static

block title
  | {{ graph }} | Wohnbiografien

block content
  .app.bio-index.site-graph-page
    .navigation.bio-navigation
      a.brand-link(href="/", aria-label="Wohnbiografien")
        img.wordmark(src="{% static 'img/Wohnbiograpfien_schriftzug.svg' %}", alt="Wohnbiografien")
      .brand-rule

      .view-title {{ graph }}
      a.admin-link(href="/") Zur Startseite
      a.admin-link(href="{% url 'export-graph-svg' graph.uuid %}") SVG Export

      .navigation-spacer
      .studio-mark
        img.studio-logo(src="{% static 'img/LUD_Logo.svg' %}", alt="LUD°")
        .studio-text Laboratory for Architecture
          br
          | and Urban Density

    .site-graph-area
      .graph-area
        {{ graph_svg|safe }}
