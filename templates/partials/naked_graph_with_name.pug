.list-item.bio-card(onclick="app.viewGraph('{{graph.uuid}}', '{{ graph.description|escapejs }}', '{{ graph.median_usage }}', '{{ graph.get_admin_url }}')")
  .graph-area(class="{% if not original %}comparable{% endif %}")
    .graph-container
      -include 'partials/bare_graph.pug'
  .description {{ graph.description }}
