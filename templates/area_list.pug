-extends 'index.pug'
-load static

block content
  .app.bio-index
    // navigation pane
    .navigation.bio-navigation
      a.brand-link(href="/", aria-label="Wohnbiografien")
        img.wordmark(src="{% static 'img/Wohnbiograpfien_schriftzug.svg' %}", alt="Wohnbiografien")
      .brand-rule

      .controls
        .control-group
          label(for="city-filter") Stadt:
          select#city-filter(v-model="country", @change="updateGraphs")
            option(value="") Alle
            - for city in cities
              option {{ city }}
        -verbatim
          .control-group.age-control
            .control-label Alter: {{ minAge }} - {{ maxAge }} Jahre
            #age-slider.fly.wrap
      -if user.is_staff
        a.admin-link(href="/admin/") Admin
      .navigation-spacer
      .studio-mark
        img.studio-logo(src="{% static 'img/LUD_Logo.svg' %}", alt="LUD°")
        .studio-text Laboratory for Architecture
          br
          | and Urban Density

    .list-area
      -for graph in object_list
        -include 'partials/naked_graph_with_name.pug'

    #graphView.modal.fade(
      role="dialog",
      tabindex="-1",
      v-cloak,
      :class="{show: graphModalOpen}"
    )
      .modal-dialog
        .modal-content
          .modal-body
            button.close(type="button", aria-label="Close", @click="closeGraph")
              span(aria-hidden="true") &times;
            .graph-modal-layout
              .graph-sidebar
                .title(v-text="currentGraph")
                .subtitle wohnt auf durchschnittlich
                  span(v-text="' ' + currentMedian")
                  | m² im Jahr
                #main-legend Legende
                  .entries
                    span.marker.bg-gray &nbsp;
                    |  gesamte Wohnfläche
                    br
                    span.marker.bg-red &nbsp;
                    |  Wohnfläche pro Person
                    br
                    span.marker.bg-yellow &nbsp;
                    |  künftige Wohnfläche
                    br
                    span.marker.bg-yellow-solid &nbsp;
                    |  künftige Wohnfläche pro Person
                  a.graph-export(
                    href="{{ initial_graph_export_url }}",
                    v-bind:href="currentExportUrl",
                    target="_blank",
                    rel="noopener"
                  ) SVG Export
                  a.graph-edit(
                    href="{{ initial_graph.admin_url|default:'#' }}",
                    v-bind:href="currentAdminUrl || '#'",
                    target="_blank",
                    rel="noopener",
                    v-if="currentAdminUrl"
                  ) Bearbeiten
              .graph-panel(
                ref="graphPanel",
                @mouseenter="beginGraphZoom",
                @mousemove="moveGraphZoom",
                @mouseleave="endGraphZoom",
                @click="toggleGraphZoom"
              )
                .graph-area(:class="{zoomed: graphZoomed}")
                  img.graph-image(
                    ref="graphImage",
                    v-if="currentExportUrl && currentExportUrl !== '#'",
                    :src="currentExportUrl",
                    :alt="currentGraph",
                    :style="graphImageStyle",
                    @load="handleGraphImageLoad"
                  )
    .modal-backdrop.fade(v-cloak, v-show="graphModalOpen", :class="{show: graphModalOpen}", @click="closeGraph")
    script#initial-graph-state(type="application/json")
      | {{ initial_graph_json|safe }}

block extra_script
  script(src="{% static 'js/omni-slider.js' %}")
  script(src="{% static 'js/vue.js' %}")
  script(src="{% static 'js/area_list.js' %}")
